---
// The whole instrument, once, parameterised by language.
//
// Both pages render this component, which is the point: the ids and roles
// main.ts looks for cannot drift between languages, and a markup change cannot
// land on one language and not the other. The pages themselves are a single
// line each.
import Layout from "../layouts/Layout.astro";
import { IDLE_READOUT, READOUT_WIDTH } from "../scripts/readout.ts";
import { LOCALES, ORDER, type Locale } from "../i18n/strings.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale];

const alternates = ORDER.map((code) => ({ lang: LOCALES[code].lang, href: LOCALES[code].href }));
const others = ORDER.filter((code) => code !== locale).map((code) => LOCALES[code]);
---

<Layout strings={t} alternates={alternates}>
  <header>
    <nav aria-label={t.navLabel}>
      <!--
        The maker's mark, and like the nameplate on the cabinet it keeps its
        Latin stamping in every language: the lettering belongs to the object,
        not to the reader. Everything the document says is translated.
      -->
      <a class="wordmark" href={t.href}>Theremin</a>
      {
        others.map((other) => (
          <a class="lang-switch" href={other.href} lang={other.lang} hreflang={other.lang}>
            {other.endonym}
          </a>
        ))
      }
    </nav>
  </header>
  <main>
    <h1 class="visually-tucked">{t.heading}</h1>
    <div id="stage" tabindex="0" role="application" aria-label={t.stageLabel}>
      <div id="cabinet" aria-hidden="true">
        <div class="antenna antenna-pitch"></div>
        <div class="antenna antenna-volume">
          <div class="antenna-volume-loop"></div>
        </div>
        <div class="cabinet-body">
          <span class="screw screw-left"></span>
          <span class="screw screw-right"></span>
          <span class="nameplate">THEREMIN</span>
          <!--
            The frequency meter. Inside the aria-hidden cabinet on purpose: it
            changes on every pointer move, so announcing it would drown a
            screen reader rather than help one. The stage's own label carries
            what the controls do. The idle dashes come from the same constant
            the script writes, so the served HTML and the running code cannot
            disagree about what silence looks like.
          -->
          <div class="meter">
            <span
              class="meter-value"
              id="meter-value"
              style={`--readout-width: ${READOUT_WIDTH}ch`}>{IDLE_READOUT}</span>
            <span class="meter-unit">{t.meterUnit}</span>
          </div>
        </div>
      </div>
      <p id="hint">{t.hint}</p>
    </div>
    <button id="info-toggle" type="button" aria-expanded="false" aria-controls="info-panel">
      {t.infoToggle}
    </button>
    <div id="info-panel" role="region" aria-label={t.panelLabel} hidden>
      {t.panel.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
