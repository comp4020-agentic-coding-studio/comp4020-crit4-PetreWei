---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Theremin"
  description="A browser theremin: drag, tap, or use arrow keys to bend pitch and volume in real time."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Theremin</a>
    </nav>
  </header>
  <main>
    <h1 class="visually-tucked">Theremin</h1>
    <div
      id="stage"
      tabindex="0"
      role="application"
      aria-label="Theremin play surface. Drag or tap to play; left and right change pitch, up and down change volume. When focused, arrow keys do the same."
    >
      <p id="hint">touch, click, or focus and press an arrow key</p>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
